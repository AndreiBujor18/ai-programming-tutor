{
  "name": "ai-programming-tutor-web-assets",
  "private": true,
  "scripts": {
    "build:editor": "esbuild frontend/editor-entry.js --bundle --minify --format=iife --target=es2020 --charset=utf8 --legal-comments=eof --outfile=src/ai_programming_tutor/web/editor.js",
    "check:editor": "npm run build:editor && git diff --exit-code -- src/ai_programming_tutor/web/editor.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "esbuild": "0.28.2"
  }
}
